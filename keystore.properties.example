# Copy this file to keystore.properties (gitignored) and fill in your real release keystore
# details. Generate a keystore with:
#   keytool -genkey -v -keystore release.keystore -alias sparely -keyalg RSA -keysize 2048 -validity 10000
#
# Without this file, release builds fall back to debug signing, which Play Store will reject.
storeFile=/absolute/path/to/release.keystore
storePassword=changeme
keyAlias=sparely
keyPassword=changeme
