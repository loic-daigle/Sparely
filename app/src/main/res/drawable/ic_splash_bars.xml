<?xml version="1.0" encoding="utf-8"?>
<!-- The splash mark without its coin: the three bars on the 108dp adaptive-icon canvas at scale 0.38,
     the same placement as the launcher foreground and the last frame of ic_splash_icon. The coin is
     drawn on its own (ic_splash_coin) so SplashIntro can drop it in above the bars; the system splash
     clips its icon to a circle, which would cut a falling coin off. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="54"
        android:translateY="54"
        android:scaleX="0.38"
        android:scaleY="0.38">
        <group
            android:translateX="-100"
            android:translateY="-89.5">
            <path
                android:fillColor="@color/sparely_mint"
                android:pathData="M61,110a15,15 0,0 1,15 15v20a15,15 0,0 1,-30 0v-20a15,15 0,0 1,15 -15z" />
            <path
                android:fillColor="@color/sparely_mint"
                android:pathData="M100,82a15,15 0,0 1,15 15v48a15,15 0,0 1,-30 0v-48a15,15 0,0 1,15 -15z" />
            <path
                android:fillColor="@color/sparely_mint"
                android:pathData="M139,56a15,15 0,0 1,15 15v74a15,15 0,0 1,-30 0v-74a15,15 0,0 1,15 -15z" />
        </group>
    </group>
</vector>
