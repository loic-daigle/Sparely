<?xml version="1.0" encoding="utf-8"?>
<!-- Animated splash icon (Android 12+): the mark on the 108dp adaptive-icon canvas at scale 0.38, inside
     the 66dp safe zone. The bars grow from the bottom 150ms apart with an overshoot, 600ms in all; the
     last frame matches ic_splash_bars. The coin isn't here: the system clips the splash icon to a
     circle, so SplashIntro drops it in afterwards where nothing cuts it off. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:translateX="54"
                android:translateY="54"
                android:scaleX="0.38"
                android:scaleY="0.38">
                <group
                    android:translateX="-100"
                    android:translateY="-89.5">
                    <!-- Each bar scales from its own bottom edge (y = 160). -->
                    <group
                        android:name="bar1"
                        android:pivotX="61"
                        android:pivotY="160"
                        android:scaleY="0">
                        <path
                            android:fillColor="@color/sparely_mint"
                            android:pathData="M61,110a15,15 0,0 1,15 15v20a15,15 0,0 1,-30 0v-20a15,15 0,0 1,15 -15z" />
                    </group>
                    <group
                        android:name="bar2"
                        android:pivotX="100"
                        android:pivotY="160"
                        android:scaleY="0">
                        <path
                            android:fillColor="@color/sparely_mint"
                            android:pathData="M100,82a15,15 0,0 1,15 15v48a15,15 0,0 1,-30 0v-48a15,15 0,0 1,15 -15z" />
                    </group>
                    <group
                        android:name="bar3"
                        android:pivotX="139"
                        android:pivotY="160"
                        android:scaleY="0">
                        <path
                            android:fillColor="@color/sparely_mint"
                            android:pathData="M139,56a15,15 0,0 1,15 15v74a15,15 0,0 1,-30 0v-74a15,15 0,0 1,15 -15z" />
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="bar1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/overshoot"
                android:propertyName="scaleY"
                android:startOffset="0"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bar2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/overshoot"
                android:propertyName="scaleY"
                android:startOffset="150"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bar3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/overshoot"
                android:propertyName="scaleY"
                android:startOffset="300"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
