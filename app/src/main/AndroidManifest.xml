<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sparely"
        android:name="com.example.sparely.SparelyApplication">
        
        <activity
            android:name="com.example.sparely.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sparely">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.example.sparely.widget.SavingsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_savings_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sparely_widget_info" />
        </receiver>
        
        <receiver
            android:name="com.example.sparely.notifications.VaultTransferNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name="com.example.sparely.notifications.PaydayNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name="com.example.sparely.notifications.VariableRecurringExpenseReceiver"
            android:exported="false" />

        <!-- AppFunctionService for AI assistant integration: disabled pending an authorization
             model for destructive/financial calls (unauthenticated delete, unvalidated amounts,
             a percentage-unit mismatch that could corrupt asset allocations). Kotlin sources are
             kept but unregistered; re-enable once those issues are addressed. -->

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>