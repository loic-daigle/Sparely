<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Lists installed apps so the user can pick which payment apps' notifications to read -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sparely"
        android:name="com.example.sparely.SparelyApplication">
        
        <!-- singleTop: notification taps (FLAG_ACTIVITY_CLEAR_TOP) reach the open app through
             onNewIntent instead of tearing it down and starting it over -->
        <activity
            android:name="com.example.sparely.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Sparely.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.example.sparely.widget.SavingsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_savings_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sparely_widget_info" />
        </receiver>
        
        <receiver
            android:name="com.example.sparely.notifications.VaultTransferNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name="com.example.sparely.notifications.PaydayNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name="com.example.sparely.notifications.VariableRecurringExpenseReceiver"
            android:exported="false" />

        <receiver
            android:name="com.example.sparely.notifications.AssistantActionReceiver"
            android:exported="false" />

        <receiver
            android:name="com.example.sparely.notifications.WishlistDecisionReceiver"
            android:exported="false" />

        <!-- Reads purchase notifications from the apps the user picked (Google Wallet, a bank or card
             app, PayPal) to suggest logging them. Android only binds it after the user grants
             Notification access, and every other app's notifications are ignored. -->
        <service
            android:name="com.example.sparely.payments.PaymentNotificationListener"
            android:exported="true"
            android:label="@string/payment_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.example.sparely.payments.PaymentSuggestionReceiver"
            android:exported="false" />

        <!-- Where the user approves vault transfers and refunds an AI assistant prepared. Only
             reachable through the one-time PendingIntent the AppFunction returns. -->
        <activity
            android:name="com.example.sparely.appfunctions.AssistantConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Sparely" />

        <!-- AppFunctions for on-device AI assistants (Android 16+). Read-only, and every call is
             refused until the user turns on "Allow AI assistants" in Settings. The class is
             generated by the AppFunctions KSP compiler from SparelyAppFunctionServiceBase. -->
        <service
            android:name="com.example.sparely.appfunctions.SparelyAppFunctionService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="sparely_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_functions_app_metadata" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>