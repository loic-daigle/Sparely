<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sparely"
        android:name="com.example.sparely.SparelyApplication">
        
        <activity
            android:name="com.example.sparely.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sparely">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.example.sparely.widget.SavingsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_savings_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sparely_widget_info" />
        </receiver>
        
        <receiver
            android:name="com.example.sparely.notifications.VaultTransferNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name="com.example.sparely.notifications.PaydayNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name="com.example.sparely.notifications.VariableRecurringExpenseReceiver"
            android:exported="false" />

        <receiver
            android:name="com.example.sparely.notifications.AssistantActionReceiver"
            android:exported="false" />

        <!-- AppFunctions for on-device AI assistants (Android 16+). Read-only, and every call is
             refused until the user turns on "Allow AI assistants" in Settings. The class is
             generated by the AppFunctions KSP compiler from SparelyAppFunctionServiceBase. -->
        <service
            android:name="com.example.sparely.appfunctions.SparelyAppFunctionService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="sparely_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_functions_app_metadata" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>